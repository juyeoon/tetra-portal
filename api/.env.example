# 키 목록만 둔다. 복사해서 .env로 쓰고 .env는 커밋하지 않는다.
# 운영(ECS)에서는 같은 이름을 태스크 정의 environment · secrets(금고)로 넣는다 — Portal_Console_백엔드_인프라_약속.md 4절.

# ---- 일반 값 (ECS environment) ----
TETRA_ENV=local
AWS_REGION=ap-northeast-2
# 로컬 docker compose MySQL (3307). dev RDS에 붙을 때는 SSM 포트 포워딩 13306 (계획서 2-1 ①)
DB_URL=jdbc:mysql://localhost:3307/tetra_platform?connectionTimeZone=Asia/Seoul&forceConnectionTimeZoneToSession=true
API_DOCS_ENABLED=true
TZ=Asia/Seoul
# 로컬 포트 — issuance-api 로컬(8080·8081) · Console과 겹치지 않게. 운영(ECS)은 8080
SERVER_PORT=8082

# ---- 비밀 값 (ECS secrets) ----
DB_USERNAME=portal_app
DB_PASSWORD=
# 32바이트 이상. Console의 OPS_JWT_SECRET과 다른 값
PORTAL_JWT_SECRET=
# Console과 같은 값(같은 금고). 로컬은 아무 값 — docker/local/password-link.ps1이 이 값으로 링크를 만든다
PASSWORD_LINK_HMAC_SECRET=

# ---- 로컬 실행 전용. 운영에는 넣지 않는다 ----
# local: AWS를 부르지 않는다 — 배너는 build/local-banners/에 파일로
SPRING_PROFILES_ACTIVE=local
LOCAL_MYSQL_ROOT_PASSWORD=
